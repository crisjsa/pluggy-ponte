# Copie este arquivo para .env e preencha. O .env NÃO vai para o Git.

# Credenciais da aplicação (dashboard.pluggy.ai)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# IDs das conexões (items) criadas no Meu Pluggy, separados por vírgula
PLUGGY_ITEM_IDS=

# Servidor MCP
# Token que o app web envia em "Authorization: Bearer <token>".
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_AUTH_TOKEN=
MCP_PORT=3333

# Opcionais, só para o modo público (Railway). Os padrões já servem.
# MCP_ALLOWED_IPS=160.79.104.0/21
# MCP_PUBLIC_HOST=meu-dominio.exemplo.com
